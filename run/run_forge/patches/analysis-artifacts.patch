+    def _prepare_artifact_roots(self) -> None:
+        """Authorize only dedicated output directories below this session cwd."""
+        if not self.spec.writable_artifact_roots:
+            return
+        if not self.spec.writable or self.spec.read_only_resume:
+            raise CodexSafetyError("Writable artifact roots require a writable session")
+        cwd = Path(self.spec.cwd).resolve()
+        tracked = [self.root / p for p in _nul_paths(_git_output(self.root, "ls-files", "-z"))]
+        for value in self.spec.writable_artifact_roots:
+            path = self._resolve_path(value)
+            if (path == self.root or not path.is_relative_to(self.root)
+                    or not path.is_relative_to(cwd)
+                    or ".git" in path.relative_to(self.root).parts
+                    or not path.is_dir()):
+                raise CodexSafetyError(f"Invalid writable artifact root: {path}")
+            if any(p.resolve().is_relative_to(path) for p in tracked):
+                raise CodexSafetyError(f"Writable artifact root contains tracked source: {path}")
+            self.writable_artifact_roots.add(path)
+
+    def _is_writable_artifact(self, path: str | Path) -> bool:
+        """Exempt declared output files without weakening explicit protection."""
+        if not self.writable_artifact_roots:
+            return False
+        raw = Path(path)
+        if not raw.is_absolute():
+            raw = self.root / raw
+        absolute = Path(os.path.abspath(raw))
+        resolved = absolute.resolve()
+        exact = {self._resolve_path(p) for p in self.spec.protected_paths if p}
+        if self.driver_path is not None:
+            exact.add(self.driver_path)
+        if (not absolute.is_relative_to(self.root)
+                or resolved in exact or absolute.is_symlink()):
+            return False
+        if ".git" in absolute.relative_to(self.root).parts:
+            return False
+        return any(absolute.is_relative_to(root) and resolved.is_relative_to(root)
+                   for root in self.writable_artifact_roots)
+
